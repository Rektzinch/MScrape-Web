# Wajib untuk menerbitkan dan memverifikasi kode aktivasi Pro/Max.
# Buat string acak yang panjang (minimal 32 karakter) dan jangan commit nilainya.
MSCRAPE_LICENSE_SECRET=

# Domain produksi untuk canonical URL, sitemap, robots.txt, dan Open Graph.
# Tetapkan di Vercel, misalnya: https://mscrape-web.vercel.app
NEXT_PUBLIC_SITE_URL=

# Opsional: token verifikasi HTML dari Google Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Opsional: ganti sumber dengan gosom/google-maps-scraper yang kamu host.
# MAPS_API_BASE_URL=https://maps-api.example.com
# MAPS_API_MODE=web
# MAPS_API_KEY=

# Wajib di produksi: Redis REST bersama untuk cooldown, ledger lisensi, revokasi, dan ownership job.
# Gunakan Upstash Redis REST atau endpoint Redis REST yang kompatibel. Jangan commit nilainya.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opsional namun sangat disarankan untuk scan Free: Cloudflare Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY aman dipublikasikan; secret hanya dipakai server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Header IP yang hanya ditambahkan oleh reverse proxy tepercaya.
# Untuk aplikasi yang diproxy Cloudflare, gunakan cf-connecting-ip dan blokir akses origin langsung di Vercel.
MSCRAPE_TRUSTED_IP_HEADER=cf-connecting-ip

# TTL ownership job backend; harus memenuhi atau melebihi masa retensi job backend.
MSCRAPE_JOB_OWNERSHIP_TTL_SECONDS=86400
